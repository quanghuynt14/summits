{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "summits",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "summits.huy0x.dev", "custom_domain": true }],
  "observability": { "enabled": true }
}
